# ─────────────────────────────────────────────────────────────────────
# EyeCLIP .gitignore
# Tracked: code, docs, small result CSVs (results/).
# Never tracked: datasets, embeddings/weights, secrets, Drive mounts.
# ─────────────────────────────────────────────────────────────────────

# ── Secrets & credentials — never commit tokens or keys ──
.env
.env.*
*.key
*.pem
*.token
secrets.*
credentials.*
service-account*.json

# ── Datasets & derived artifacts (licences may forbid redistribution) ──
data/
datasets/
embeddings/
features/
checkpoints/
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
# Note: results/*.csv (small summary tables) ARE tracked on purpose.

# ── Google Drive / Colab VM paths (safety net — never commit these) ──
drive/
gdrive/
MyDrive/
sample_data/
.config/
.local/
.ipynb_checkpoints/

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ── Tool caches ──
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── OS / editors ──
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
